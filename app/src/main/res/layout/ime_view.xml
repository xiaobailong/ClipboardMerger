<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1B5E20"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- 顶部状态栏 + 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/tvImeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 剪贴板监听"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPasteLast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FF388E3C"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="粘贴"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPasteAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="#FFFF9800"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="全部粘贴"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSwitchBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="#FF2E7D32"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="切换"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 清空剪切板按钮 -->
    <Button
        android:id="@+id/btnClearClipboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFB00020"
        android:text="清空系统剪切板"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>